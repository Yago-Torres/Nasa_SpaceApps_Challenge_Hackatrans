# Example configuration only — NO actual credentials in Git.
APP_ENV=development
# Required by /api/v1/auth/* and /api/v1/cases* (ABB-05/06); without it those routes answer 503.
# Apply migrations first: cd backend && uv run --locked alembic upgrade head
DATABASE_URL=postgresql+psycopg://agro:local_dev_only@localhost:5432/agroblackbox
REDIS_URL=redis://localhost:6379/0
# Add external API credentials only when an approved integration actually requires them.
# Literature (ABB-13). Optional: anonymous OpenAlex search is shared per IP and may be paused under load.
# OPENALEX_API_KEY=
# Optional Crossref polite-pool contact (team address, not a personal one), sent only in the User-Agent.
# CROSSREF_MAILTO=
