# Copy to deploy/.env on the host (chmod 600). Never commit deploy/.env.
# Release to run: a git tag published by .github/workflows/release.yml (or built locally with --build).
CROPSTORY_VERSION=v0.0.0
# Images: ghcr.io/<owner>/cropstory-api:<tag> and -web:<tag>. Lower-case owner.
CROPSTORY_IMAGE_PREFIX=ghcr.io/yago-torres/cropstory
APP_ENV=demo

# PostgreSQL inside the stack (not published on any port). Generate: openssl rand -base64 32
POSTGRES_USER=cropstory
POSTGRES_DB=cropstory
POSTGRES_PASSWORD=change-me

# Web port on 127.0.0.1 only; the Cloudflare tunnel connects to it.
WEB_PORT=8080

# /api/metrics is disabled unless this is set (16+ characters). Generate: openssl rand -hex 24
METRICS_TOKEN=

# Optional external-source settings (ABB-13). Team values only, never personal ones.
OPENALEX_API_KEY=
CROSSREF_MAILTO=

# Backups (deploy/bin/backup.sh): directory on the host and how many dumps to keep.
BACKUP_DIR=/var/backups/cropstory
BACKUP_KEEP=14

# Memory limits for small hosts (Raspberry Pi).
API_MEM_LIMIT=512m
WEB_MEM_LIMIT=128m
